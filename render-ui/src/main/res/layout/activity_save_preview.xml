<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_theme">

    <SurfaceView
        android:id="@+id/save_preview_surface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/save_preview_image"
        app:layout_constraintBottom_toTopOf="@id/save_preview_actions"
        app:layout_constraintDimensionRatio="W,9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/save_preview_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="52dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/editor_back"
        android:padding="12dp"
        android:src="@drawable/icon_capture_back"
        android:tint="@color/background_second"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/save_preview_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/background_second"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/save_preview_back" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/save_preview_actions"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/save_preview_save"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:background="@drawable/background_save_preview_button"
            android:backgroundTint="@null"
            android:enabled="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/save_preview_save"
            android:textAllCaps="false"
            android:textColor="@color/background_second"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
