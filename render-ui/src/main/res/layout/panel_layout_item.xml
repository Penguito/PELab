<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/panel_background_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/selection_panel_none"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/panel_background_none"
            android:contentDescription="@string/selection_panel_none"
            android:padding="8dp"
            android:src="@drawable/icon_panel_none"
            android:tint="@color/panel_header_icon" />

        <View
            android:id="@+id/selection_panel_none_divider"
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="10dp"
            android:background="@color/render_ui_panel_divider" />

        <HorizontalScrollView
            android:id="@+id/selection_panel_category_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/selection_panel_categories"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/render_ui_panel_background_content"
        android:minHeight="120dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/selection_panel_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="@color/render_ui_background_white"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:id="@+id/selection_panel_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/selection_panel_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </FrameLayout>

</LinearLayout>
